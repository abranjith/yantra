{
  "version": 1,
  "hooks": [
    {
      "name": "format-after-implement",
      "description": "Run the formatter after implementation; block on failure.",
      "events": ["implement.post"],
      "type": "command",
      "run": "npm run format",
      "onFailure": "abort",
      "timeoutMs": 120000
    },
    {
      "name": "prepare-worktree",
      "enabled": true,
      "options": {
        "fromBranch": "development"
      }
    },
    {
      "name": "commit-progress",
      "enabled": true
    },
    {
      "name": "create-pull-request",
      "enabled": true,
      "options": {
        "provider": "github",
        "targetBranch": "development"
      }
    }
  ]
}
