{
  "name": "@yantra/agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yantra agent — thin AgentProvider seam over @earendil-works/pi-coding-agent. The Pi SDK is imported only under src/adapters/pi/; @yantra/core must never import this package (architectural boundary).",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.6",
    "@yantra/core": "workspace:*",
    "@yantra/protocol": "workspace:*",
    "pino": "^9.9.2",
    "typebox": "1.1.38",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@yantra/test-helpers": "workspace:*",
    "fast-check": "^4.7.0"
  }
}
