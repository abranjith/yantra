{
  "name": "@yantra/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Drshya — Yantra's design system: OKLCH tokens on Tailwind v4, an icon registry, and accessible React Aria primitives. Browser code only: imports protocol types, never core, agent or Node built-ins.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./drshya.css": "./src/styles/drshya.css",
    "./gallery": {
      "types": "./dist/gallery/index.d.ts",
      "import": "./dist/gallery/index.js"
    }
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "scripts": {
    "build": "tsx scripts/emit-tokens.ts --check && tsc -b tsconfig.build.json && vite build --config gallery/vite.config.ts",
    "gallery": "vite --config gallery/vite.config.ts",
    "emit:tokens": "tsx scripts/emit-tokens.ts",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/martian-mono": "5.3.0",
    "lucide-react": "1.68.0",
    "react": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.4",
    "tailwindcss-react-aria-components": "2.2.0",
    "tsx": "4.23.15",
    "vite": "8.3.5"
  }
}
