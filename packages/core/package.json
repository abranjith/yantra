{
  "name": "@yantra/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yantra core engine — browser, locator, executor, sanitizer, secrets, workflow.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./locator": {
      "types": "./dist/locator/index.d.ts",
      "import": "./dist/locator/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:injected": "tsx src/locator/build.ts",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@yantra/protocol": "workspace:*",
    "keytar": "^7.9.0",
    "puppeteer-core": "^24.43.1",
    "robots-parser": "^3.0.1",
    "yaml": "^2.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@yantra/test-helpers": "workspace:*",
    "esbuild": "^0.25.0",
    "fast-check": "^4.7.0",
    "jsdom": "^26.0.0"
  }
}
