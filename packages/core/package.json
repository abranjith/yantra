{
  "name": "@yantra/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yantra core engine — browser, locator, executor, sanitizer, secrets, workflow.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./extraction": {
      "types": "./dist/extraction/index.d.ts",
      "import": "./dist/extraction/index.js"
    },
    "./locator": {
      "types": "./dist/locator/index.d.ts",
      "import": "./dist/locator/index.js"
    },
    "./workflow/replay": {
      "types": "./dist/workflow/replay/index.d.ts",
      "import": "./dist/workflow/replay/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "build:injected": "tsx src/locator/build.ts",
    "build:recorder-overlay": "tsx src/workflow/recorder/overlay/bundle.ts",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@yantra/protocol": "workspace:*",
    "cheerio": "^1.1.2",
    "croner": "^10.0.1",
    "jsdom": "^26.0.0",
    "jsonata": "^2.0.5",
    "keytar": "^7.9.0",
    "marked": "^15.0.12",
    "picocolors": "^1.1.1",
    "pino": "^9.9.2",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "puppeteer-core": "^24.43.1",
    "robots-parser": "^3.0.1",
    "undici": "^7.16.0",
    "wink-eng-lite-web-model": "^1.8.1",
    "wink-nlp": "^2.4.0",
    "yaml": "^2.7.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/prompts": "^2.4.9",
    "@types/proper-lockfile": "^4.1.4",
    "@yantra/test-helpers": "workspace:*",
    "esbuild": "^0.25.0",
    "fast-check": "^4.7.0"
  }
}
