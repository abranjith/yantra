{
  "name": "@yantra/protocol",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yantra Protocol — Zod schemas as the single source of truth.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsx scripts/emit-all.ts && tsc -b tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "emit": "tsx scripts/emit-all.ts",
    "verify-generated": "tsx scripts/verify-generated.ts",
    "verify-exports": "tsx scripts/verify-exports.ts",
    "verify": "tsx scripts/verify-generated.ts && tsx scripts/verify-exports.ts && tsc --noEmit",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "fast-check": "^4.3.0",
    "tsx": "^4.20.6"
  }
}
