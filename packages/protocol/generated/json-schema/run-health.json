{
  "$ref": "#/definitions/RunHealth",
  "definitions": {
    "RunHealth": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1,
          "description": "Run-health schema version."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "Owning run id."
        },
        "searches": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Searches attempted (ok + failed)."
            },
            "ok": {
              "type": "integer",
              "minimum": 0,
              "description": "Searches that returned results."
            },
            "failed_by_code": {
              "type": "object",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              },
              "propertyNames": {
                "minLength": 1
              },
              "description": "Failed searches by stable failure code."
            },
            "providers": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Distinct search providers used, in first-use order."
            },
            "breaker_skipped": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Searches refused without a provider call because an earlier challenge opened the search breaker (FEAT-050)."
            },
            "peak_concurrency": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Most provider searches in flight at once (FEAT-050)."
            }
          },
          "required": [
            "total",
            "ok",
            "failed_by_code",
            "providers"
          ],
          "additionalProperties": false,
          "description": "Web searches by outcome."
        },
        "fetches": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Real network page fetches."
            },
            "by_mode": {
              "type": "object",
              "properties": {
                "http": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Pages served by the HTTP tier."
                },
                "browser": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Pages served by a browser render."
                }
              },
              "required": [
                "http",
                "browser"
              ],
              "additionalProperties": false,
              "description": "Network fetches by how they were served."
            },
            "repeat_fetches": {
              "type": "integer",
              "minimum": 0,
              "description": "Network fetches of a normalized URL already fetched earlier in the run."
            },
            "failed_by_code": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
              },
              "propertyNames": {
                "minLength": 1
              },
              "description": "Failed `web_fetch` calls by stable error code."
            },
            "cache_hits": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Reads answered from the run document store with no network fetch (FEAT-050)."
            },
            "memo_hits": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Reads answered from the remembered terminal failure of an earlier read (FEAT-050)."
            },
            "challenges": {
              "type": "object",
              "properties": {
                "http": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Human-verification pages served to the HTTP tier."
                },
                "browser": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "Human-verification pages served to the browser render."
                }
              },
              "required": [
                "http",
                "browser"
              ],
              "additionalProperties": false,
              "description": "Challenge pages seen, by tier (FEAT-050)."
            }
          },
          "required": [
            "total",
            "by_mode",
            "repeat_fetches",
            "failed_by_code"
          ],
          "additionalProperties": false,
          "description": "Network page fetches."
        },
        "source_failures": {
          "type": "object",
          "properties": {
            "fetch": {
              "type": "integer",
              "minimum": 0,
              "description": "Per-site fetch failures."
            },
            "extract": {
              "type": "integer",
              "minimum": 0,
              "description": "Per-site pages fetched but not readable."
            },
            "blocked": {
              "type": "integer",
              "minimum": 0,
              "description": "Per-site ethics refusals (robots, blocklist, rate limit)."
            },
            "budget": {
              "type": "integer",
              "minimum": 0,
              "description": "Page reads skipped by the run's own navigation/host budget (web_search sites and web_fetch calls)."
            },
            "policy": {
              "type": "integer",
              "minimum": 0,
              "description": "Per-site reads refused by the run's own URL policy."
            }
          },
          "required": [
            "fetch",
            "extract",
            "blocked",
            "budget",
            "policy"
          ],
          "additionalProperties": false,
          "description": "Per-site read failures inside multi-source tools, by stage."
        },
        "browser": {
          "type": "object",
          "properties": {
            "launches": {
              "type": "integer",
              "minimum": 0,
              "description": "Successful browser process launches."
            },
            "pool_launches": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Launches of the run's shared background page pool (FEAT-050)."
            },
            "contexts": {
              "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties",
              "description": "Isolated browser contexts the page pool opened, one per background page (FEAT-050)."
            }
          },
          "required": [
            "launches"
          ],
          "additionalProperties": false,
          "description": "Browser processes."
        },
        "budgets": {
          "type": "object",
          "properties": {
            "navigations_used": {
              "type": "integer",
              "minimum": 0,
              "description": "Navigations consumed."
            },
            "navigations_limit": {
              "type": "integer",
              "minimum": 0,
              "description": "Configured navigation ceiling."
            },
            "hosts_used": {
              "type": "integer",
              "minimum": 0,
              "description": "Distinct hosts consumed."
            },
            "hosts_limit": {
              "type": "integer",
              "minimum": 0,
              "description": "Configured distinct-host ceiling."
            },
            "exhausted": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "description": "Budget limits that refused at least one call, in first-hit order."
            }
          },
          "required": [
            "navigations_used",
            "navigations_limit",
            "hosts_used",
            "hosts_limit",
            "exhausted"
          ],
          "additionalProperties": false,
          "description": "Run budget consumption."
        },
        "tool_failures": {
          "type": "object",
          "properties": {
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Tool calls that ended in error or timeout."
            },
            "by_code": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
              },
              "propertyNames": {
                "minLength": 1
              },
              "description": "Failed tool calls by stable error code."
            }
          },
          "required": [
            "total",
            "by_code"
          ],
          "additionalProperties": false,
          "description": "Tool failures across every tool."
        },
        "notices": {
          "type": "integer",
          "minimum": 0,
          "description": "Runtime-derived notices attached to the published document; 0 when nothing was published."
        },
        "extraction": {
          "type": "object",
          "properties": {
            "pages_by_shape": {
              "type": "object",
              "properties": {
                "article": {
                  "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
                },
                "collection": {
                  "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
                },
                "table": {
                  "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
                },
                "detail": {
                  "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
                },
                "index": {
                  "$ref": "#/definitions/RunHealth/properties/searches/properties/failed_by_code/additionalProperties"
                }
              },
              "additionalProperties": false,
              "description": "Shape-aware page reads returned to the model, by page shape."
            },
            "records_shown": {
              "type": "integer",
              "minimum": 0,
              "description": "Collection records shown to the model."
            },
            "links_offered": {
              "type": "integer",
              "minimum": 0,
              "description": "Links offered to the model (byte-identical after sanitizing)."
            },
            "links_withheld": {
              "type": "integer",
              "minimum": 0,
              "description": "Links withheld because the model-visible transform would have altered them."
            },
            "discovered_follows": {
              "type": "integer",
              "minimum": 0,
              "description": "Successful web_fetch and browser_navigate calls to a URL a read page offered."
            }
          },
          "required": [
            "pages_by_shape",
            "records_shown",
            "links_offered",
            "links_withheld",
            "discovered_follows"
          ],
          "additionalProperties": false,
          "description": "Shape-aware extraction (FEAT-051): pages by shape, records, and links."
        },
        "capture": {
          "type": "object",
          "properties": {
            "vision_assist": {
              "type": "object",
              "properties": {
                "available": {
                  "type": "boolean",
                  "description": "Whether the capability is registered for this run."
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "grant_missing",
                      "model_no_image_input",
                      "no_browser_tools",
                      "suppressed_by_flag",
                      "zero_llm"
                    ],
                    "description": "A condition that keeps Vision Assist off."
                  },
                  "description": "Every condition that keeps it off; empty exactly when available."
                }
              },
              "required": [
                "available",
                "reasons"
              ],
              "additionalProperties": false,
              "description": "Whether Vision Assist (screenshots sent to the model) is available, and why not."
            },
            "deliverable": {
              "type": "object",
              "properties": {
                "available": {
                  "type": "boolean",
                  "description": "Whether the capability is registered for this run."
                },
                "reasons": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "suppressed_by_flag",
                      "no_browser",
                      "no_interaction_tools"
                    ],
                    "description": "A condition that keeps deliverable capture off."
                  },
                  "description": "Every condition that keeps it off; empty exactly when available."
                }
              },
              "required": [
                "available",
                "reasons"
              ],
              "additionalProperties": false,
              "description": "Whether deliverable capture (screenshots kept on this computer) is available, and why not."
            },
            "deliverable_calls": {
              "type": "integer",
              "minimum": 0,
              "description": "Successful browser_capture calls."
            },
            "deliverable_files": {
              "type": "integer",
              "minimum": 0,
              "description": "PNG files browser_capture wrote."
            },
            "deliverable_bytes": {
              "type": "integer",
              "minimum": 0,
              "description": "Bytes browser_capture wrote."
            }
          },
          "required": [
            "vision_assist",
            "deliverable",
            "deliverable_calls",
            "deliverable_files",
            "deliverable_bytes"
          ],
          "additionalProperties": false,
          "description": "Both capture capabilities with reason codes, and what deliverable capture wrote (FEAT-058)."
        }
      },
      "required": [
        "schema_version",
        "run_id",
        "searches",
        "fetches",
        "source_failures",
        "browser",
        "budgets",
        "tool_failures",
        "notices"
      ],
      "additionalProperties": false,
      "description": "An agentic run's own health summary (run-health.json): searches, fetches, source failures, browser launches, budgets, tool failures, and runtime notices. Counts and closed codes only."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
