{
  "$ref": "#/definitions/Brief",
  "definitions": {
    "Brief": {
      "type": "object",
      "properties": {
        "brief_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Unique Brief document id (ULID)."
        },
        "task_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
          "description": "Originating task id (ULID)."
        },
        "schema_version": {
          "type": "string",
          "const": "0.2",
          "description": "Protocol schema version this document was written under."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "description": "One-line document title."
        },
        "overview": {
          "type": "string",
          "description": "Answer-first Markdown synthesis (1-3 paragraphs) with inline [n] citations."
        },
        "key_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Markdown text of the finding. Inline [n] markers are optional: the LLM path may emit them, while the deterministic path carries citations only in the structured citations[] array. The structured array is the single source of truth for rendering."
              },
              "citations": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "A source number (sources[].n)."
                },
                "description": "Source numbers (sources[].n) backing this finding. At least one is required unless editorial is true."
              },
              "editorial": {
                "type": "boolean",
                "default": false,
                "description": "True marks uncited synthesis commentary — the only legal uncited form."
              },
              "facet": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ],
                      "description": "A scalar facet value."
                    }
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Optional structured payload (for example { price: 328, in_stock: true }), or null."
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Markdown text of a nested child finding."
                    },
                    "citations": {
                      "type": "array",
                      "items": {
                        "$ref": "#/definitions/Brief/properties/key_findings/items/properties/citations/items"
                      },
                      "minItems": 1,
                      "description": "Source numbers (sources[].n) backing this child finding; at least one is required."
                    }
                  },
                  "required": [
                    "text",
                    "citations"
                  ],
                  "additionalProperties": false,
                  "description": "A one-level nested finding under a key finding."
                },
                "default": [],
                "description": "Nested child findings that elaborate this parent; one level deep only."
              }
            },
            "required": [
              "text",
              "citations"
            ],
            "additionalProperties": false,
            "description": "A scannable, citation-backed finding bullet."
          },
          "description": "Scannable findings; may be empty."
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "alternatives"
                ],
                "description": "Labels off-contract alternatives; absent for ordinary sections."
              },
              "heading": {
                "type": "string",
                "minLength": 1,
                "description": "Section heading."
              },
              "body_md": {
                "type": "string",
                "description": "Markdown body prose; must not contain raw ANSI escapes."
              },
              "citations": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/Brief/properties/key_findings/items/properties/citations/items"
                },
                "description": "Source numbers (sources[].n) cited by this section."
              }
            },
            "required": [
              "heading",
              "body_md",
              "citations"
            ],
            "additionalProperties": false,
            "description": "A deep-detail prose section of the Brief."
          },
          "description": "Deep-detail sections; empty at the overview synthesis budget."
        },
        "facets": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "comparison": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "columns": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "minItems": 1,
                          "description": "Column headers."
                        },
                        "rows": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "$ref": "#/definitions/Brief/properties/key_findings/items/properties/facet/anyOf/0/additionalProperties"
                            },
                            "description": "One comparison row."
                          },
                          "description": "Comparison rows; every row length must equal columns.length."
                        },
                        "row_citations": {
                          "type": "array",
                          "items": {
                            "type": "array",
                            "items": {
                              "$ref": "#/definitions/Brief/properties/key_findings/items/properties/citations/items"
                            },
                            "description": "Source numbers (sources[].n) backing this content."
                          },
                          "description": "Sources backing each row, in row order; length must equal rows.length."
                        }
                      },
                      "required": [
                        "columns",
                        "rows"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "null"
                    }
                  ],
                  "description": "Tabular comparison data, or null when the query has no comparative shape."
                }
              },
              "required": [
                "comparison"
              ],
              "additionalProperties": false,
              "description": "Structured/tabular facets of the Brief."
            },
            {
              "type": "null"
            }
          ],
          "description": "Structured/tabular facets, or null when the query has no comparative shape."
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cited": {
                "type": "boolean",
                "description": "True for evidence cited by the answer; false for consulted-only sources. All-or-none across sources."
              },
              "n": {
                "type": "integer",
                "minimum": 1,
                "description": "Citation number; contiguous 1..N in array order."
              },
              "url": {
                "type": "string",
                "format": "uri",
                "description": "URL as fetched."
              },
              "final_url": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uri"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Post-redirect landing URL, or null when no redirect was observed."
              },
              "host": {
                "type": "string",
                "minLength": 1,
                "description": "Source host."
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Page title, or null when unavailable."
              },
              "excerpt": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null,
                "description": "Short extracted snippet of the source content, or null when not captured."
              },
              "fetched_at": {
                "type": "string",
                "format": "date-time",
                "description": "ISO-8601 UTC fetch timestamp."
              },
              "published_at": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date-time"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "ISO-8601 publication timestamp, or null when unknown."
              }
            },
            "required": [
              "n",
              "url",
              "host",
              "title",
              "fetched_at",
              "published_at"
            ],
            "additionalProperties": false,
            "description": "A numbered, deduplicated source reference."
          },
          "description": "Numbered, deduplicated source references."
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60,
                "description": "Condition name from the task contract."
              },
              "value": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Condition value."
              },
              "status": {
                "type": "string",
                "enum": [
                  "verified",
                  "unverified",
                  "violated"
                ],
                "description": "Whether the condition is confirmed, unknown, or not met."
              },
              "citations": {
                "$ref": "#/definitions/Brief/properties/facets/anyOf/0/properties/comparison/anyOf/0/properties/row_citations/items",
                "default": [],
                "description": "Evidence backing the status; verified requires at least one source."
              }
            },
            "required": [
              "name",
              "value",
              "status"
            ],
            "additionalProperties": false,
            "description": "A declared condition and its evidence-backed delivery status."
          },
          "maxItems": 24,
          "description": "Declared conditions and their delivery statuses; absent on older artifacts."
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^(?:deliverable|fill|effects\\.submit|artifact:screenshot:(?:viewport|full_page|element)|filter:\\S(?:.{0,58}\\S)?)$",
                "description": "Requirement id: deliverable, filter:<name>, fill, artifact:screenshot:<scope>, or effects.submit."
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "description": "Plain-words name of the requirement."
              },
              "status": {
                "type": "string",
                "enum": [
                  "met",
                  "unmet",
                  "not_applicable"
                ],
                "description": "Whether evidence shows the requirement met, unmet, or not applicable."
              },
              "reason": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "What the evidence showed, or null when nothing needs saying."
              },
              "declared_in": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 1
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The contract revision that declared the requirement, or null when not tracked."
              },
              "exemptions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 120,
                      "description": "Field label."
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "disabled",
                        "read_only",
                        "hidden",
                        "file_input",
                        "human_verification"
                      ],
                      "description": "Why the engine left a form control out of \"fill every eligible field\"."
                    }
                  },
                  "required": [
                    "label",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "description": "A form control the engine left out of \"fill every eligible field\"."
                },
                "maxItems": 20,
                "description": "Controls the engine judged exempt from the fill requirement."
              },
              "exempt_overflow": {
                "type": "integer",
                "minimum": 1,
                "description": "How many more exempt controls exist beyond the listed ones."
              }
            },
            "required": [
              "id",
              "label",
              "status",
              "reason",
              "declared_in"
            ],
            "additionalProperties": false,
            "description": "One declared requirement of the task contract and its evidence-judged status."
          },
          "maxItems": 16,
          "description": "Each declared requirement of a do task and its evidence-judged status; absent on older artifacts and on ask and research Briefs."
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "screenshot",
                "description": "The artifact kind."
              },
              "scope": {
                "type": "string",
                "enum": [
                  "viewport",
                  "full_page",
                  "element"
                ],
                "description": "What a screenshot covers: the visible viewport, the full page, or one element."
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "description": "Run-relative path of the artifact file, using forward slashes."
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$",
                "description": "Lowercase hex SHA-256 of the file bytes."
              },
              "bytes": {
                "type": "integer",
                "minimum": 0,
                "description": "File size in bytes."
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Image width in pixels."
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "description": "Image height in pixels."
              },
              "part": {
                "type": "integer",
                "minimum": 1,
                "description": "1-based position of this file in its capture set."
              },
              "parts": {
                "type": "integer",
                "minimum": 1,
                "maximum": 6,
                "description": "How many files the capture set holds."
              },
              "complete": {
                "type": "boolean",
                "description": "False when the set was clipped or truncated and does not show the whole target."
              },
              "labels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "clipped_width",
                    "truncated",
                    "beyond_viewport"
                  ],
                  "description": "A label on a capture set: clipped_width, truncated, or beyond_viewport."
                },
                "maxItems": 3,
                "description": "Labels on the capture set."
              }
            },
            "required": [
              "kind",
              "scope",
              "path",
              "sha256",
              "bytes",
              "width",
              "height",
              "part",
              "parts",
              "complete",
              "labels"
            ],
            "additionalProperties": false,
            "description": "One saved capture file the run produced, linked relative to the run directory."
          },
          "maxItems": 12,
          "description": "Saved capture files of a do task, one entry per file in capture order; absent on older artifacts and on ask and research Briefs."
        },
        "metadata": {
          "type": "object",
          "properties": {
            "search_provider": {
              "type": [
                "string",
                "null"
              ],
              "description": "Search provider that produced the source candidates, or null."
            },
            "synthesis": {
              "type": "string",
              "enum": [
                "deterministic",
                "llm"
              ],
              "description": "Synthesis strategy that produced the Brief."
            },
            "deterministic_fallback_used": {
              "type": "boolean",
              "description": "True when the LLM path failed and the deterministic synthesizer took over."
            },
            "coverage": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Fraction of fetched sources represented in the Brief (0-1), or null."
            },
            "freshness": {
              "type": [
                "string",
                "null"
              ],
              "description": "Human-readable freshness signal (for example \"today\"), or null."
            },
            "citation_verdict": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "claims_checked": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Claims inspected by the citation-faithfulness validator."
                    },
                    "flagged": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Claims flagged as unanchored."
                    },
                    "stripped": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Claims stripped as unanchored."
                    }
                  },
                  "required": [
                    "claims_checked",
                    "flagged",
                    "stripped"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Citation-faithfulness verdict (filled post-synthesis), or null before validation."
            },
            "usage": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "input_tokens": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "LLM input tokens consumed."
                    },
                    "output_tokens": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "LLM output tokens produced."
                    },
                    "cost_usd": {
                      "type": "number",
                      "minimum": 0,
                      "description": "Estimated LLM cost in USD."
                    }
                  },
                  "required": [
                    "input_tokens",
                    "output_tokens",
                    "cost_usd"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "description": "LLM usage totals, or null on the deterministic path."
            },
            "evidence": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "candidate_claims": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Claim candidates considered before the eligibility gates."
                    },
                    "accepted_claims": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Claims that passed the eligibility gates and reached the Brief."
                    },
                    "excluded_sources": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Sources dropped by the query-relevance gate before assembly."
                    }
                  },
                  "required": [
                    "candidate_claims",
                    "accepted_claims",
                    "excluded_sources"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "description": "Evidence-selection counts from the deterministic pipeline (candidate vs accepted claims, excluded sources), or null on the LLM path."
            },
            "run_id": {
              "type": [
                "string",
                "null"
              ],
              "description": "Owning run id, or null outside a run context."
            }
          },
          "required": [
            "search_provider",
            "synthesis",
            "deterministic_fallback_used",
            "coverage",
            "freshness",
            "usage",
            "run_id"
          ],
          "additionalProperties": false,
          "description": "Provenance and quality signals."
        },
        "notices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string",
                "description": "Host or subsystem the notice concerns."
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "description": "Human-readable reason for the notice."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "fetch_failed",
                  "extract_failed",
                  "blocked",
                  "source_excluded",
                  "uncited_claim_stripped",
                  "uncited_claim_flagged",
                  "budget_exhausted",
                  "limited_evidence",
                  "search_failed",
                  "contract_gap",
                  "other"
                ],
                "description": "Notice classification. `contract_gap` marks a part of the declared task contract not delivered, a condition not confirmed or not met, or rows shown as alternatives because they do not come from a required source. `source_excluded` marks a source dropped as irrelevant to the query before assembly; `limited_evidence` marks a Brief that fell short of the requested length because too few relevant findings survived the evidence gates; `search_failed` marks web searches that failed during the run, grouped by stable failure code (source `search:<provider>`); `budget_exhausted` marks a run budget (navigations, hosts) that Yantra itself imposed running out, never a site refusing access."
              }
            },
            "required": [
              "source",
              "reason",
              "kind"
            ],
            "additionalProperties": false,
            "description": "An honest per-source failure or validator flag."
          },
          "description": "Honest per-source failures and validator flags; may be empty."
        }
      },
      "required": [
        "brief_id",
        "task_id",
        "schema_version",
        "title",
        "overview",
        "key_findings",
        "sections",
        "facets",
        "sources",
        "metadata",
        "notices"
      ],
      "additionalProperties": false,
      "description": "The universal synthesized output document: answer-first overview, key findings, sections, facets, numbered sources, notices, and metadata. Every citation resolves to a declared source (no uncited claims)."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
