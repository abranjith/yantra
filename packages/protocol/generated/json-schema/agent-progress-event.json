{
  "$ref": "#/definitions/AgentProgressEvent",
  "definitions": {
    "AgentProgressEvent": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "recovery",
              "description": "The stall/turn-limit recovery ladder fired a rung."
            },
            "rung": {
              "type": "string",
              "enum": [
                "steer",
                "freeze",
                "stop"
              ],
              "description": "The recovery rung that fired."
            },
            "trigger": {
              "type": "string",
              "enum": [
                "stalled",
                "turn-timeout"
              ],
              "description": "What triggered recovery: no progress, or a turn over its thinking limit."
            },
            "move": {
              "anyOf": [
                {
                  "type": "string",
                  "enum": [
                    "fill-remaining",
                    "list-fields",
                    "capture",
                    "publish"
                  ]
                },
                {
                  "type": "null"
                }
              ],
              "description": "The next supported move the run was steered to, or null on stop."
            },
            "summary": {
              "type": "string",
              "description": "One-line, render-safe description of the recovery step."
            },
            "at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO-8601 UTC timestamp of emission."
            }
          },
          "required": [
            "type",
            "rung",
            "trigger",
            "move",
            "summary",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "progress",
              "description": "Declared requirements advanced."
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Requirement id, such as `fill:email` or `artifact:screenshot:viewport`."
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "fill",
                      "artifact",
                      "effects",
                      "deliverable"
                    ],
                    "description": "What kind of requirement the item tracks."
                  },
                  "label": {
                    "type": "string",
                    "maxLength": 60,
                    "description": "Short human label, at most 60 characters."
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "advancing",
                      "met"
                    ],
                    "description": "pending (untouched), advancing (related work happened), or met."
                  },
                  "done": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Units done, or null when not counted."
                  },
                  "total": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "description": "Units required, or null when not counted."
                  }
                },
                "required": [
                  "id",
                  "kind",
                  "label",
                  "state",
                  "done",
                  "total"
                ],
                "additionalProperties": false,
                "description": "One declared requirement and how far the run has got with it."
              },
              "description": "Every declared requirement and its live state."
            },
            "summary": {
              "type": "string",
              "maxLength": 160,
              "description": "One-line progress summary, at most 160 characters."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "items",
            "summary",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "assistant_text",
              "description": "The model streamed reply text."
            },
            "text": {
              "type": "string",
              "description": "A sanitized chunk of the model’s streamed reply."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "text",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool_started",
              "description": "A tool call started."
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "description": "Tool name."
            },
            "summary": {
              "type": "string",
              "description": "Bounded input summary (field names only, never values)."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "tool",
            "summary",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "tool_finished",
              "description": "A tool call finished."
            },
            "tool": {
              "type": "string",
              "minLength": 1,
              "description": "Tool name."
            },
            "summary": {
              "type": "string",
              "description": "Bounded result summary: status and error code only."
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "error",
                "denied",
                "aborted"
              ],
              "description": "How the call ended."
            },
            "durationMs": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ],
              "description": "Call duration in milliseconds, or null when the start was not observed."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "tool",
            "summary",
            "status",
            "durationMs",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "contract_declared",
              "description": "A task contract revision was declared and echoed."
            },
            "revision": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "description": "1-based contract revision."
            },
            "summary": {
              "type": "string",
              "maxLength": 400,
              "description": "One-line echo of the normalized, sanitized contract."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "revision",
            "summary",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "capability_gap",
              "description": "A declared item cannot be delivered by this run."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "description": "The requirement id, such as `artifact:screenshot:viewport`."
            },
            "reason": {
              "type": "string",
              "enum": [
                "suppressed_by_flag",
                "no_browser",
                "no_interaction_tools"
              ],
              "description": "Why the item cannot be delivered."
            },
            "summary": {
              "type": "string",
              "description": "One-line, ASCII-only disclosure; the run continues."
            },
            "at": {
              "$ref": "#/definitions/AgentProgressEvent/anyOf/0/properties/at"
            }
          },
          "required": [
            "type",
            "item",
            "reason",
            "summary",
            "at"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Agent progress event, discriminated by `type` (the connector shape)."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
