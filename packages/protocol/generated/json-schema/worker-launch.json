{
  "$ref": "#/definitions/WorkerLaunch",
  "definitions": {
    "WorkerLaunch": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 1
        },
        "invocation": {
          "type": "object",
          "properties": {
            "invocation_id": {
              "type": "string",
              "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
              "description": "Client-generated ULID; the idempotency key for launching (D11)."
            },
            "path": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "description": "Canonical command path, aliases resolved (e.g. [\"do\"] for \"discover\")."
            },
            "argv": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Tokens after the path, exactly as given, in order."
            },
            "cwd": {
              "type": "string",
              "description": "Absolute working directory the invocation was requested from."
            }
          },
          "required": [
            "invocation_id",
            "path",
            "argv",
            "cwd"
          ],
          "additionalProperties": false,
          "description": "A requested command invocation."
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "Run ID preallocated by the host slot reservation (D11)."
        },
        "result_path": {
          "type": "string",
          "description": "Where the worker writes its WorkerResult, once."
        }
      },
      "required": [
        "schema_version",
        "invocation",
        "result_path"
      ],
      "additionalProperties": false,
      "description": "What a detached worker runs. Owner-only, exclusively created; user text never reaches the worker argv."
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
