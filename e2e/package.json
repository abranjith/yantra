{
  "name": "@yantra/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-package end-to-end tests (golden traces, chaos, recorder/replay).",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern node_modules",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@yantra/agent": "workspace:*",
    "@yantra/cli": "workspace:*",
    "@yantra/core": "workspace:*",
    "@yantra/protocol": "workspace:*",
    "@yantra/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5",
    "@types/ws": "8.18.2",
    "@yantra/test-helpers": "workspace:*",
    "axe-core": "4.14.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.10.0",
    "ws": "8.22.2",
    "zod": "^3.24.1"
  }
}
