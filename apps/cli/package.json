{
  "name": "@yantra/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Yantra CLI entrypoint.",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "yantra": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo --glob \"*.tsbuildinfo\""
  },
  "dependencies": {
    "@yantra/agent": "workspace:*",
    "@yantra/core": "workspace:*",
    "@yantra/protocol": "workspace:*",
    "boxen": "^8.0.1",
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.2",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/marked-terminal": "^6.1.1",
    "@yantra/test-helpers": "workspace:*",
    "fast-check": "^4.7.0"
  }
}
