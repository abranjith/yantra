{
  "name": "@yantra/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Yantra app: a browser client of the local app host, built and embedded into the CLI. Browser code only: protocol types, Drshya components, never core, agent or Node built-ins.",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-router": "1.170.46",
    "@yantra/protocol": "workspace:*",
    "@yantra/ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5"
  }
}
